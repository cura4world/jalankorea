  "lessons": [
    {
      "unit": 1,
      "status": "draft",
      "id": "gram1",
      "category": {
        "ko": "문법 · 1과",
        "id": "Tata bahasa 1"
      },
      "title": {
        "ko": "-(으)세요 / -부터 -까지",
        "id": "-(으)세요 / -부터 -까지"
      },
      "lede": {
        "ko": "시험과 작업장에서 가장 먼저 만나는 두 가지 문형입니다.",
        "id": "Dua pola kalimat pertama yang Anda temui di ujian dan tempat kerja."
      },
      "body": [
        {
          "h": {
            "ko": "① -(으)세요 — 정중한 지시·요청",
            "id": "① -(으)세요 — perintah/permintaan sopan"
          },
          "p": {
            "ko": "받침이 없으면 <b>-세요</b>, 받침이 있으면 <b>-으세요</b>를 붙입니다. 작업 지시와 안내방송에 매우 자주 나옵니다.",
            "id": "Tanpa konsonan akhir pakai <b>-세요</b>, dengan konsonan akhir pakai <b>-으세요</b>. Sangat sering di instruksi kerja dan pengumuman."
          },
          "phrases": [
            [
              "안전모를 쓰세요.",
              "Pakailah helm."
            ],
            [
              "여기에 앉으세요.",
              "Silakan duduk di sini."
            ],
            [
              "휴게실에서 기다리세요.",
              "Tunggulah di ruang istirahat."
            ]
          ]
        },
        {
          "h": {
            "ko": "② -부터 -까지 — 시작과 끝",
            "id": "② -부터 -까지 — dari ... sampai ..."
          },
          "p": {
            "ko": "<b>부터</b>는 시작, <b>까지</b>는 끝. 근무 시간·기간 문제의 단골 표현입니다.",
            "id": "<b>부터</b> = mulai, <b>까지</b> = sampai. Selalu muncul di soal jam kerja dan jadwal."
          },
          "phrases": [
            [
              "8시부터 6시까지 일해요.",
              "Bekerja dari jam 8 sampai jam 6."
            ],
            [
              "월요일부터 금요일까지",
              "Dari Senin sampai Jumat"
            ],
            [
              "여기부터 저기까지 옮기세요.",
              "Pindahkan dari sini sampai sana."
            ]
          ]
        },
        {
          "warn": {
            "ko": "시험 포인트",
            "id": "Poin ujian"
          },
          "wp": {
            "ko": "듣기에서 \"몇 시부터\"를 물으면 시작 시각을, \"몇 시까지\"를 물으면 끝나는 시각을 찾아야 합니다. 숫자만 듣고 고르면 함정에 걸립니다.",
            "id": "Di soal dengar, \"몇 시부터\" menanyakan jam mulai, \"몇 시까지\" jam selesai. Kalau hanya dengar angka tanpa partikel, Anda kena jebakan."
          }
        }
      ],
      "source_line": {
        "ko": "자체 제작 학습 자료 · 1과 / 예정 24과",
        "id": "Materi orisinal · Pelajaran 1 dari 24"
      }
    },
    {
      "unit": 2,
      "status": "draft",
      "id": "gram2",
      "category": {
        "ko": "문법 · 2과",
        "id": "Tata bahasa 2"
      },
      "title": {
        "ko": "-아/어요 / 안 -",
        "id": "-아/어요 / 안 -"
      },
      "lede": {
        "ko": "일상 대화와 시험 듣기의 기본이 되는 현재형 존댓말과 부정 표현입니다.",
        "id": "Bentuk sopan sehari-hari (present) dan cara membuat kalimat negatif — dasar untuk percakapan dan soal dengar."
      },
      "body": [
        {
          "h": {
            "ko": "① -아/어요 — 정중한 현재형",
            "id": "① -아/어요 — bentuk sopan (present)"
          },
          "p": {
            "ko": "어간 끝 모음이 <b>ㅏ·ㅗ</b>면 <b>-아요</b>, 그 밖에는 <b>-어요</b>, <b>하다</b>는 <b>해요</b>가 됩니다.",
            "id": "Jika vokal akhir kata dasar <b>ㅏ·ㅗ</b> pakai <b>-아요</b>, selain itu <b>-어요</b>, dan <b>하다</b> menjadi <b>해요</b>."
          },
          "phrases": [
            ["가요", "(saya) pergi"],
            ["먹어요", "(saya) makan"],
            ["일해요", "(saya) bekerja"],
            ["좋아요", "bagus / suka"]
          ]
        },
        {
          "h": {
            "ko": "② 안 + 동사 — 부정",
            "id": "② 안 + kata kerja — negatif"
          },
          "p": {
            "ko": "동사·형용사 앞에 <b>안</b>을 붙이면 '~하지 않다'가 됩니다. 가장 쉽고 자주 쓰는 부정입니다.",
            "id": "Menaruh <b>안</b> di depan kata kerja/sifat berarti 'tidak ...'. Cara negatif yang paling umum dan mudah."
          },
          "phrases": [
            ["안 가요", "tidak pergi"],
            ["안 먹어요", "tidak makan"],
            ["안 아파요", "tidak sakit"]
          ]
        },
        {
          "warn": {
            "ko": "시험 포인트",
            "id": "Poin ujian"
          },
          "wp": {
            "ko": "듣기에서 <b>안</b> 한 글자를 놓치면 뜻이 정반대가 됩니다. '일해요'와 '일 안 해요'를 끝까지 듣고 구분하세요.",
            "id": "Di soal dengar, jika melewatkan satu kata <b>안</b>, artinya jadi kebalikannya. Dengarkan sampai akhir untuk membedakan '일해요' dan '일 안 해요'."
          }
        }
      ],
      "source_line": {
        "ko": "자체 제작 학습 자료 · 2과 / 예정 24과",
        "id": "Materi orisinal · Pelajaran 2 dari 24"
      }
    }
  ]
}